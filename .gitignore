*.pubxml
*.publishsettings
PublishScripts/

# Archivos de configuracion con secretos (no versionar credenciales)
appsettings.Development.json
appsettings.*.local.json
*.env

# Logs
*.log

# Archivos temporales del sistema operativo
Thumbs.db
.DS_Store
